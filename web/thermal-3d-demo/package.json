{
  "name": "rwh-core-thermal-3d-demo",
  "version": "1.1.0",
  "private": true,
  "description": "CoRE Building Google Photorealistic 3D Tiles + thermal overlay (measured fallback)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:public": "node -e \"process.env.THERMAL_DEMO_STRIP_KEY='1'; require('child_process').execSync('npx vite build',{stdio:'inherit',env:process.env})\"",
    "preview": "vite preview --host",
    "check": "node --check src/main.js"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.4.18",
    "three": "0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
